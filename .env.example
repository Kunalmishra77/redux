# REDUX Platform — environment variables
# Copy to .env.local (dev) or set on the VPS (staging/production).
# NEVER commit a filled-in copy. See blueprint/03-architecture/04-auth-security-rls.md §6.

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SERVER ONLY — CI fails the build if this reaches a client bundle

# ── Meta (Lead Ads + WhatsApp + CAPI) ──────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=               # non-expiring, from REDUX's Business Manager
META_PAGE_ID=
META_WEBHOOK_VERIFY_TOKEN=            # any random string; must match the Meta webhook config
META_GRAPH_VERSION=v25.0              # pin it
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_CAPI_DATASET_ID=                 # WhatsApp conversions dataset

# ── Google Ads ─────────────────────────────────────────────────────────────
GOOGLE_ADS_WEBHOOK_KEY=               # the secret you set on the lead form asset

# ── Razorpay ───────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── MSG91 (SMS — OTP only) ─────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=                      # 6-char DLT-registered header
MSG91_DLT_TE_ID=

# ── Infrastructure ─────────────────────────────────────────────────────────
GOTENBERG_URL=http://gotenberg:3000   # internal only, never publicly exposed
CRON_SECRET=                          # X-Cron-Secret header for /api/cron/*
SENTRY_DSN=
NODE_ENV=development

# ── URLs ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://reduxbath.com
NEXT_PUBLIC_APP_URL=https://app.reduxbath.com
NEXT_PUBLIC_PORTAL_URL=https://my.reduxbath.com
